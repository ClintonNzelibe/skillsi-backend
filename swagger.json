{
  "openapi": "3.0.0",
  "info": {
    "title": "Skillsi API Documentation",
    "version": "1.0.0",
    "description": "API documentation for the Skillsi e-learning platform, providing endpoints for course management, user authentication, enrollment, payments, and content delivery. This API enables seamless integration for mobile and web applications, supporting features like video streaming, quizzes, progress tracking, and instructor management."
  },
  "servers": [
    {
      "url": "http://localhost:5500/api/v1"
    },
    {
      "url": "https://skillsi-backend.onrender.com/api/v1"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register User",
        "tags": ["Auth"],
        "description": "Register a new user by providing authProvider, full name, email, and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "authProvider": {
                    "type": "string",
                    "enum": ["manual", "google", "twitter"],
                    "x-enumNames": [
                      "Manual Login",
                      "Google Login",
                      "Twitter Login"
                    ],
                    "default": "manual"
                  },
                  "fullName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": ["fullName", "email", "password", "authProvider"]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Registered successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login User",
        "tags": ["Auth"],
        "description": "Login a user by providing email, and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Login successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    }
  }
}
